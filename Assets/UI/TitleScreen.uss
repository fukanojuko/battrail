.title-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 8, 20, 0.25);
}

.game-title {
    color: rgb(255, 255, 255);
    font-size: 96px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 32px;
}

.prompt {
    color: rgb(255, 220, 90);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 48px;
}

.controls-hint {
    align-items: center;
}

.hint {
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    margin-bottom: 4px;
}
