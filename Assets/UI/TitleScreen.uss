.title-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 8, 20, 0.25);
}

.game-title {
    color: rgb(255, 255, 255);
    font-size: 96px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 32px;
}

.mode-select {
    align-items: center;
    margin-bottom: 48px;
}

.mode-option {
    color: rgba(255, 255, 255, 0.55);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    padding: 6px 32px;
    margin-bottom: 8px;
    /* 選択枠の分の幅を常に確保しておく（選択移動で項目がずれないように） */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

/* 選択中の項目。色だけだと視認性が弱いので枠も出す */
.mode-option.selected {
    color: rgb(255, 220, 90);
    border-color: rgba(255, 220, 90, 0.7);
}

.controls-hint {
    align-items: center;
}

.hint {
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    margin-bottom: 4px;
}
