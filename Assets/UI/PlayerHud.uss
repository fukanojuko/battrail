.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.player-panel {
    width: 50%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 24px;
}

.info {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* ミニマップの置き場所。中身（コース線・走者アイコン）は MinimapElement が組み立てる。
   パネル内の隅に置くのは、走行中に見る画面中央を塞がないため。 */
.minimap-host {
    position: absolute;
    /* 上のポーズヒントを避けた位置 */
    top: 34px;
    left: 24px;
    width: 140px;
    height: 180px;
}

.minimap {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 6px;
}

/* コース線を描く面。アイコンより下に敷く。 */
.minimap-track {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 走者アイコン。位置は left/top を px で直接与える（コースの縦横比を保った変換をかけるため）。 */
.minimap-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.75);
}

.minimap-dot.hidden {
    display: none;
}

.minimap-dot--p1 {
    background-color: rgb(64, 178, 255);
}

.minimap-dot--p2 {
    background-color: rgb(255, 138, 64);
}

/* 自機は一回り大きく白フチにして、視線を止めずに自分の位置を拾えるようにする */
.minimap-dot--self {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.gauge-bg {
    width: 240px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    padding: 2px;
}

.gauge-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(64, 178, 255);
    border-radius: 3px;
}

/* スタートのカウントダウン。走行中の視界を塞がないよう、result(0.45) / pause(0.6) より薄くする。 */
.countdown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.3);
}

.countdown-overlay.hidden {
    display: none;
}

.countdown-text {
    color: rgb(255, 255, 255);
    font-size: 120px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.9);
}

.result-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.result-overlay.hidden {
    display: none;
}

.result-text {
    color: rgb(255, 255, 255);
    font-size: 72px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

.result-hint {
    color: rgba(255, 255, 255, 0.8);
    font-size: 18px;
    margin-top: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.quit-hint {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.pause-overlay.hidden {
    display: none;
}

.pause-title {
    color: rgb(255, 255, 255);
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

.pause-hint {
    color: rgba(255, 255, 255, 0.8);
    font-size: 18px;
    margin-top: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
