.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.player-panel {
    width: 50%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 24px;
}

.info {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.gauge-bg {
    width: 240px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    padding: 2px;
}

.gauge-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(64, 178, 255);
    border-radius: 3px;
}

.result-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.result-overlay.hidden {
    display: none;
}

.result-text {
    color: rgb(255, 255, 255);
    font-size: 72px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

.result-hint {
    color: rgba(255, 255, 255, 0.8);
    font-size: 18px;
    margin-top: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
