.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.player-panel {
    width: 50%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 24px;
}

.info {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* 進行バー。コース全長を 1 本の帯で表し、両者の位置をアイコンで重ねる。
   進捗 fill を敷かないのは、読み取りたいのが絶対進捗ではなく両者の前後差だから。
   画面上部に絶対配置する（top は quit-hint と重ならない位置）。 */
.progress-track {
    position: absolute;
    /* 上のポーズヒントと、帯の上に出す残距離・アイコンのぶんを空けた位置 */
    top: 48px;
    left: 48px;
    right: 48px;
    height: 4px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 2px;
}

/* 右端＝ゴール。帯だけだと進行方向の終点が読めないので目盛りを立てる。 */
.progress-goal {
    position: absolute;
    right: 0;
    top: -2px;
    bottom: -2px;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

.progress-marker {
    position: absolute;
    top: -3px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.75);
    /* left に進捗％を入れるので、アイコンの中心がその位置に来るよう半個ぶん戻す */
    translate: -50% 0;
}

.progress-marker.hidden {
    display: none;
}

.mark-p1 {
    background-color: rgb(64, 178, 255);
}

.mark-p2 {
    background-color: rgb(255, 138, 64);
}

/* 自機は一回り大きく白フチにして、視線を止めずに自分の位置を拾えるようにする */
.progress-marker.self {
    top: -5px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

/* ゴールまでの残距離。進捗バーの右上（＝ゴール目盛りの真上）に置く。
   バーの子にしてあるので、バーを動かせば数値も付いてくる。 */
.distance {
    position: absolute;
    right: 0;
    bottom: 10px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.gauge-bg {
    width: 240px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    padding: 2px;
}

.gauge-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(64, 178, 255);
    border-radius: 3px;
}

/* スタートのカウントダウン。走行中の視界を塞がないよう、result(0.45) / pause(0.6) より薄くする。 */
.countdown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.3);
}

.countdown-overlay.hidden {
    display: none;
}

.countdown-text {
    color: rgb(255, 255, 255);
    font-size: 120px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.9);
}

.result-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.result-overlay.hidden {
    display: none;
}

.result-text {
    color: rgb(255, 255, 255);
    font-size: 72px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

.result-hint {
    color: rgba(255, 255, 255, 0.8);
    font-size: 18px;
    margin-top: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.quit-hint {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.pause-overlay.hidden {
    display: none;
}

.pause-title {
    color: rgb(255, 255, 255);
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

.pause-hint {
    color: rgba(255, 255, 255, 0.8);
    font-size: 18px;
    margin-top: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
