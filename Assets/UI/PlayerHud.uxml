<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PlayerHud.uss?fileID=7433441132597879392&amp;guid=e52b4c62da420453f9b289a1716aa143&amp;type=3#PlayerHud"/>
    <ui:VisualElement name="root" picking-mode="Ignore" class="root">
        <ui:Label name="quit-hint" text="ESC / Start ボタン: ポーズ" class="quit-hint"/>
        <ui:VisualElement name="left" picking-mode="Ignore" class="player-panel">
            <ui:Image source="project://database/Assets/Contents/Artist/UI/BoostRingUI/BattrailRingUI.png?fileID=2800000&amp;guid=78980635d9388414da1e2e0b3b6a61e8&amp;type=3#BattrailRingUI" name="Image">
                <ui:Image source="project://database/Assets/Contents/Artist/UI/BoostRingUI/BattrailUIBoostUI.png?fileID=2800000&amp;guid=b77a63b3733ff3e4daa22497185c81a4&amp;type=3#BattrailUIBoostUI" name="Image"/>
            </ui:Image>
            <ui:Label name="p0-info" text="P1" class="info"/>
            <ui:VisualElement class="gauge-bg">
                <ui:VisualElement name="p0-fill" class="gauge-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right" picking-mode="Ignore" class="player-panel">
            <ui:Image source="project://database/Assets/Contents/Artist/UI/BoostRingUI/BattrailRingUI.png?fileID=2800000&amp;guid=78980635d9388414da1e2e0b3b6a61e8&amp;type=3#BattrailRingUI">
                <ui:Image source="project://database/Assets/Contents/Artist/UI/BoostRingUI/BattrailUIBoostUI.png?fileID=2800000&amp;guid=b77a63b3733ff3e4daa22497185c81a4&amp;type=3#BattrailUIBoostUI"/>
            </ui:Image>
            <ui:Label name="p1-info" text="P2" class="info"/>
            <ui:VisualElement picking-mode="Position" enabled="true" class="gauge-bg" style="flex-direction: column-reverse; opacity: 1; background-repeat: no-repeat no-repeat;">
                <ui:VisualElement name="p1-fill" class="gauge-fill" style="background-color: rgb(64, 178, 255); background-image: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="minimap" picking-mode="Ignore" class="minimap-host"/>
        <ui:VisualElement name="countdown" picking-mode="Ignore" class="countdown-overlay hidden">
            <ui:Label name="countdown-text" text="" class="countdown-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="result" picking-mode="Ignore" class="result-overlay hidden">
            <ui:Label name="result-text" text="" class="result-text"/>
            <ui:Label name="result-hint" text="SPACE / Start ボタン: もう一度　　ESC / Select ボタン: タイトルへ" class="result-hint"/>
        </ui:VisualElement>
        <ui:VisualElement name="pause" picking-mode="Ignore" class="pause-overlay hidden">
            <ui:Label text="PAUSED" class="pause-title"/>
            <ui:Label text="ESC / Start ボタン: 再開　　Q / Select ボタン: タイトルへ" class="pause-hint"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
