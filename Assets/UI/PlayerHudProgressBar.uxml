<!--
    ゴールまでの距離バー（現在は未使用・非表示）。ミニマップに置き換えたため PlayerHud.uxml から外した。
    復活させる手順:
      1. 下の progress-track ブロック 2 つを PlayerHud.uxml の各 player-panel の先頭に戻す
      2. PlayerHud.uxml の Style に PlayerHudProgressBar.uss を追加する
      3. C# 側は PlayerHudUI が HudProgressBar を呼び続けているので変更不要
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PlayerHudProgressBar.uss" />
    <ui:VisualElement name="p0-progress" picking-mode="Ignore" class="progress-track">
        <ui:VisualElement class="progress-goal" />
        <ui:VisualElement name="p0-mark1" class="progress-marker mark-p2" />
        <ui:VisualElement name="p0-mark0" class="progress-marker mark-p1 self" />
        <ui:Label name="p0-distance" text="--" class="distance" />
    </ui:VisualElement>
    <ui:VisualElement name="p1-progress" picking-mode="Ignore" class="progress-track">
        <ui:VisualElement class="progress-goal" />
        <ui:VisualElement name="p1-mark0" class="progress-marker mark-p1" />
        <ui:VisualElement name="p1-mark1" class="progress-marker mark-p2 self" />
        <ui:Label name="p1-distance" text="--" class="distance" />
    </ui:VisualElement>
</ui:UXML>
